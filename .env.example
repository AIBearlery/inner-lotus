# Inner Lotus — environment variables
#
# Copy this file to `.env.local` and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API).
#
# These are EXPO_PUBLIC_ variables: Expo/Metro inlines them into the app bundle at
# build time, so the publishable key ships inside the compiled app. That is expected
# and safe here BECAUSE every table has Row Level Security enabled — RLS is the real
# security boundary, not the key. Never put a service_role/secret key in an
# EXPO_PUBLIC_ variable.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
